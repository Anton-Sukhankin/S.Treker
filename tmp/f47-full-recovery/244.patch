+function getFragment(startMarker, endMarker) {
+  const start = indexHtml.indexOf(startMarker);
+  const end = indexHtml.indexOf(endMarker, start);
+  assert.ok(start >= 0 && end > start, `Missing inventory boundary: ${startMarker}`);
+  return indexHtml.slice(start, end + endMarker.length);
+}
