+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { existsSync, readFileSync, readdirSync } from 'node:fs';
+import { createRequire } from 'node:module';
+import { resolve } from 'node:path';
+
+const root = resolve(import.meta.dirname, '..');
+const require = createRequire(import.meta.url);
+const readJson = path => JSON.parse(readFileSync(resolve(root, path), 'utf8'));
+const policy = readJson('vendor/tend-ui/compensation-policy.json');
+const packageJson = readJson('package.json');
+const packageLock = readJson('package-lock.json');
+
+assert.equal(policy.schemaVersion, 1, 'Unsupported compensation policy schema');
+assert.equal(policy.sourcePolicy, 'reviewed-local-tarball');
+
+for (const [name, definition] of Object.entries(policy.packages)) {
+  const tarballPath = resolve(root, 'vendor', 'tend-ui', definition.tarball);
+  assert.ok(existsSync(tarballPath), `Missing compensation tarball for ${name}`);
+
+  const sha256 = createHash('sha256').update(readFileSync(tarballPath)).digest('hex');
+  assert.equal(sha256, definition.sha256, `${name} tarball checksum changed`);
+  assert.equal(
+    packageJson.dependencies[name],
+    `file:vendor/tend-ui/${definition.tarball}`,
+    `${name} must resolve from its reviewed tarball`,
+  );
+  assert.equal(
+    packageLock.packages[`node_modules/${name}`]?.resolved,
+    `file:vendor/tend-ui/${definition.tarball}`,
+    `${name} lock entry must remain local`,
+  );
+
+  const installedMetadata = readJson(`node_modules/${name}/package.json`);
+  assert.equal(installedMetadata.version, definition.version, `${name} version drifted`);
+  assert.equal(installedMetadata.private, true, `${name} compensation must remain private`);
+  assert.equal(installedMetadata.license, 'UNLICENSED', `${name} compensation must not be published`);
+}
+
+const lodashPolicy = policy.packages.lodash;
+const lodashModule = await import('lodash');
+assert.deepEqual(Object.keys(lodashModule).sort(), [...lodashPolicy.allowedExports].sort());
+
+const lodashFiles = readdirSync(resolve(root, 'node_modules', 'lodash'));
+for (const excludedApi of lodashPolicy.excludedUpstreamApis) {
+  assert.equal(excludedApi in lodashModule, false, `lodash.${excludedApi} must stay absent`);
+  assert.equal(
+    lodashFiles.some(file => file.toLowerCase().startsWith(`${excludedApi.toLowerCase()}.`)),
+    false,
+    `lodash ${excludedApi} implementation must stay absent`,
+  );
+}
+
+const nested = { secret: 'kept' };
+const omitResult = lodashModule.omit(
+  { safe: true, nested, 'nested.secret': 'removed-direct-key' },
+  ['nested.secret', '__proto__.tendUiPolluted'],
+);
+assert.equal(omitResult.safe, true);
+assert.equal(omitResult.nested, nested, 'local omit must not traverse nested paths');
+assert.equal('nested.secret' in omitResult, false, 'local omit must delete the direct own key');
+assert.equal(Object.prototype.tendUiPolluted, undefined, 'local omit must not pollute Object.prototype');
+
+const uuidPolicy = policy.packages.uuid;
+const uuidModule = require('uuid');
+assert.deepEqual(Object.keys(uuidModule).sort(), [...uuidPolicy.allowedExports].sort());
+for (const excludedApi of uuidPolicy.excludedUpstreamApis) {
+  assert.equal(excludedApi in uuidModule, false, `uuid.${excludedApi} must stay absent`);
+}
+
+const callerBuffer = new Uint8Array(16).fill(7);
+const callerBufferSnapshot = [...callerBuffer];
+const generatedUuid = uuidModule.v4({}, callerBuffer, 0);
+assert.match(
+  generatedUuid,
+  /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i,
+  'local uuid v4 must return a valid version-4 string',
+);
+assert.deepEqual([...callerBuffer], callerBufferSnapshot, 'local uuid v4 must not mutate caller buffers');
+
+console.log('Tend UI local-compensation security verification passed.');
+console.log(`Reviewed local compensations: ${Object.keys(policy.packages).length}`);
+console.log('Checks: checksum, local lock source, private metadata, API allowlist and advisory behavior');
