+  domainScoped: {
+    ecm: keys.slice(2, 4),
+    tracker: keys.slice(4, 6),
+    control: keys.slice(6, 8),
+  },
+  triggerSurfaces: countMatches(filterDrawer, /class="ds-multi-select__input js-ms-trigger"/g),
+  clearActions: countMatches(filterDrawer, /class="ds-multi-select__clear js-ms-clear"/g),
