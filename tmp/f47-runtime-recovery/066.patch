+          title="Закрыть"
+          type="button"
+          variant="ghost"
+        />,
+        closeMount,
+      )}
+      <Button
+        className="js-filter-reset"
+        data-testid="tend-ui-filter-drawer-reset"
+        size="medium"
+        style={actionStyle}
+        type="button"
+        variant="ghost"
+      >
+        Сбросить всё
+      </Button>
+      <Button
+        className="js-filter-apply"
+        data-testid="tend-ui-filter-drawer-apply"
+        size="medium"
+        style={actionStyle}
+        type="button"
+        variant="primary"
+      >
+        Применить
+      </Button>
+    </>
+  );
+}
+
+export function mountTendUiFilterDrawerActions() {
+  const closeMount = document.getElementById('tend-ui-filter-drawer-close-root');
+  const actionsMount = document.getElementById('tend-ui-filter-drawer-actions-root');
+
+  if (!closeMount || !actionsMount) return false;
+
+  return renderTendUi(<FilterDrawerActions closeMount={closeMount} />, actionsMount);
+}
